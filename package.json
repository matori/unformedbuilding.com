{
  "name": "unformedbuilding",
  "private": true,
  "version": "9.1.0",
  "description": "Unformed Building",
  "scripts": {
    "build": "del '_build' && ELEVENTY_ENV=production eleventy",
    "preview": "del '_build' && ELEVENTY_ENV=preview eleventy",
    "dev": "del '_build' && ELEVENTY_ENV=development eleventy --serve --quiet"
  },
