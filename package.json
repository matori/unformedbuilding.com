    "type": "git",
    "url": "https://github.com/matori/unformedbuilding.com"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "autoprefixer": "^10.6.2",
    "clean-css": "^5.3.3",
    "dayjs": "^1.11.23",
    "del-cli": "^8.0.1",
    "html-minifier-terser": "^7.2.0",
    "js-base64": "^3.9.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-gap-properties": "^7.0.0",
    "posthtml": "^0.16.7",
    "posthtml-doctype": "^1.1.1",
    "posthtml-minify-classnames": "^0.3.0",
    "purgecss": "^8.0.0",
    "purgecss-from-html": "^8.0.0",
    "sass": "^1.106.1",
